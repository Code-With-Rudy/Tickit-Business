# Copy to .env for local development (never commit .env). On Vercel, add these as Environment Variables.

# Required: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# Required on Vercel: paste the ENTIRE service-account JSON on one line.
# Locally you can instead save the file as serviceAccountKey.json in the project root.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Recommended in production (e.g. a free Upstash Redis URL): shared rate-limit storage
RATELIMIT_STORAGE_URI=

# Optional: only if the frontend is ever served from a different origin
ALLOWED_ORIGINS=
